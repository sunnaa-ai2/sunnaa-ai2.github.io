APP_NAME="Sunnaa AI 2 API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_LOCALE=ar

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- MySQL ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sunnaa_ai2
DB_USERNAME=sunnaa
DB_PASSWORD=
# Some hosted MySQL services require TLS; set to the CA file path they give you (optional).
MYSQL_ATTR_SSL_CA=

# No sessions or queues are needed for a token API.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---- The site ----
FRONTEND_URL=https://sunnaa-ai2.github.io
CORS_ORIGINS=https://sunnaa-ai2.github.io
ADMIN_EMAILS=azanmd0592344829@gmail.com,ahmedafana652001@gmail.com
LOGIN_LINK_TTL=30
API_TOKEN_DAYS=30
MAX_UPLOAD_KB=51200

# ---- Files: "local" on a server with a persistent disk, or "s3" ----
FILES_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---- E-mail (login links). Brevo example ----
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=azanmd0592344829@gmail.com
MAIL_FROM_NAME="صُنّاع AI 2"
